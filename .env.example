# ==============================================================================
# Midas - Configuración de Variables de Entorno (Plantilla)
# Proyecto: Midas Enterprise Active Lakehouse & Conversational Intelligence Platform
# Repositorio: https://github.com/Dan18eP/Midas
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración General del Proyecto y Docker
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=midas
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Red y Dominios Internos
# ------------------------------------------------------------------------------
DOCKER_NETWORK_NAME=midas-network

# ------------------------------------------------------------------------------
# 1. Base de Datos Principal (PostgreSQL Multi-Tenant)
# ------------------------------------------------------------------------------
POSTGRES_USER=midas_admin
POSTGRES_PASSWORD=midas_secret_password_2026
POSTGRES_HOST=midas-postgres
POSTGRES_PORT=5432
# Bases de datos creadas automáticamente por init-multi-db.sh:
POSTGRES_MULTIPLE_DATABASES=iceberg_catalog,midas_operational,openmetadata_db,airflow_db,midas_guardian

# Conexión directa a PostgreSQL Operacional (Fuente de Ingesta)
OPERATIONAL_DB_URL=postgresql://midas_admin:midas_secret_password_2026@midas-postgres:5432/midas_operational

# ------------------------------------------------------------------------------
# 2. Almacenamiento de Objetos MinIO S3 & Iceberg REST Catalog
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=midas_minio_admin
MINIO_ROOT_PASSWORD=midas_minio_secret_2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://midas-minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1

# Catálogo Apache Iceberg REST
ICEBERG_REST_PORT=8181
ICEBERG_CATALOG_URL=http://midas-iceberg-catalog:8181

# ------------------------------------------------------------------------------
# 3. Cómputo Distribuido (Apache Spark & PySpark)
# ------------------------------------------------------------------------------
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_WORKER_WEBUI_PORT=8081
SPARK_MASTER_URL=spark://midas-spark-master:7077
SPARK_WORKER_MEMORY=1G
SPARK_WORKER_CORES=1

# ------------------------------------------------------------------------------
# 4. Motor de Consultas Ultrarrápido (Trino)
# ------------------------------------------------------------------------------
TRINO_PORT=8082
TRINO_USER=trino_admin
TRINO_HOST=midas-trino

# ------------------------------------------------------------------------------
# 5. Orquestación (Apache Airflow)
# ------------------------------------------------------------------------------
AIRFLOW_WEBSERVER_PORT=8085
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./src/orchestration
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=midas_airflow_admin_2026
AIRFLOW_ADMIN_EMAIL=admin@midas.local
# Provide a Fernet key before using Airflow with production credentials.
AIRFLOW_FERNET_KEY=
AIRFLOW_CONN_SPARK_DEFAULT=spark://midas-spark-master:7077
MIDAS_GOLD_SPARK_JOB=/opt/midas/jobs/materialize_gold.py

# ------------------------------------------------------------------------------
# 6. Seguridad y Gobernanza (Ranger, Atlas & OpenMetadata)
# ------------------------------------------------------------------------------
RANGER_PORT=6080
RANGER_ADMIN_USER=admin
RANGER_ADMIN_PASSWORD=ranger_admin_password_2026
RANGER_URL=http://midas-ranger:6080

# Politicas Zero-Trust (HU-GOV-03). Mientras Ranger no este desplegado, el
# motor local aplica el enmascaramiento y el filtrado por filas antes de
# enviar la consulta a Trino. Con el plugin de Ranger instalado se pone
# RANGER_LOCAL_ENFORCEMENT=false y manda el plugin.
RANGER_LOCAL_ENFORCEMENT=true
# Sin el plugin, Trino desconoce los roles y rechaza la cabecera X-Trino-Role
# con "Access Denied: Cannot set role".
RANGER_TRINO_PLUGIN_ENABLED=false

# Escudo PII en caliente (HU-GOV-02). Apache Atlas todavia no forma parte del
# compose: sin servidor, el escudo clasifica y audita igual, y marca el
# despacho como no confirmado sin interrumpir la transformacion Bronze->Silver.
ATLAS_URL=http://midas-atlas:21000
ATLAS_USERNAME=admin
ATLAS_PASSWORD=atlas_admin_password_2026
ATLAS_TIMEOUT_SECONDS=3.0
# Ventana maxima de propagacion Atlas -> Ranger (TagSync) exigida por CA-3.
ATLAS_TAGSYNC_DEADLINE_SECONDS=5.0
# Bitacora inmutable de clasificaciones PII (se replica en s3://midas-governance/).
PII_AUDIT_LOG_PATH=/var/log/midas/pii_audit.jsonl

OPENMETADATA_PORT=8585
OPENMETADATA_ADMIN_PORT=8586
OPENMETADATA_ADMIN_USER=admin
OPENMETADATA_ADMIN_PASSWORD=openmetadata_admin_password_2026
OPENMETADATA_ADMIN_PRINCIPAL=admin
OPENMETADATA_PRINCIPAL_DOMAIN=midas.local

# Cliente de gobernanza (HU-GOV-01): URL interna que usa la API para consultar
# el catalogo y el linaje. El token JWT de bot es opcional: sin el, el gateway
# de linaje degrada al linaje canonico sin romper el drawer del frontend.
OPENMETADATA_URL=http://midas-openmetadata:8585
OPENMETADATA_JWT_TOKEN=
OPENMETADATA_TIMEOUT_SECONDS=3.0
OPENMETADATA_SERVICE_ICEBERG=midas_lakehouse_iceberg
OPENMETADATA_SERVICE_POSTGRES=midas_operational_postgres

# Indice de busqueda de OpenMetadata
OPENSEARCH_PORT=9200
OPENSEARCH_HEAP=512m

# ------------------------------------------------------------------------------
# 7. Core Backend & Telemetría SSE (FastAPI)
# ------------------------------------------------------------------------------
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 8. Copiloto Agéntico (LangGraph / LLM Providers)
# ------------------------------------------------------------------------------
# Configura tu clave de proveedor Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 9. Plataforma Frontend Web (Next.js / React Flow)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SSE_URL=http://localhost:8000/api/v1/telemetry/stream
